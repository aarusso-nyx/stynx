{
  "thresholds": {
    "lines": 100,
    "statements": 100,
    "branches": 100,
    "functions": 100
  },
  "policies": {
    "coverage": {
      "default": { "lines": 85, "branches": 80, "functions": 85, "statements": 85 },
      "strict": { "lines": 95, "branches": 95, "functions": 95, "statements": 95 },
      "complete": {
        "lines": 100,
        "branches": 100,
        "functions": 100,
        "statements": 100,
        "branchesTolerance": 0
      },
      "off": { "lines": 0, "branches": 0, "functions": 0, "statements": 0 }
    },
    "mutation": {
      "default": 60,
      "strict": 80,
      "strictest": 85,
      "tier1": { "break": 90, "high": 90, "low": 80 },
      "tier2": { "break": 90, "high": 95, "low": 85 },
      "tier3": { "break": 90, "high": 100, "low": 90 }
    },
    "perf": {
      "default": {
        "p50_ms": 5000,
        "p95_ms": 9000,
        "rps_min": 0.2
      }
    }
  },
  "defaults": {
    "coverage": "complete",
    "mutation": "tier3",
    "perf": "default"
  },
  "perPackage": {
    "@aarusso-nyx/stynx-angular-audit": { "coverage": "default", "mutation": "tier1" },
    "@aarusso-nyx/stynx-angular-iam": { "coverage": "default", "mutation": "tier1" },
    "@aarusso-nyx/stynx-angular-auth": { "mutation": "tier1" },
    "@aarusso-nyx/stynx-angular-flow": { "mutation": "strict" },
    "@aarusso-nyx/stynx-angular-profile": { "mutation": "strictest" },
    "@aarusso-nyx/stynx-sdk": { "mutation": "tier1" },
    "@aarusso-nyx/stynx-audit": { "mutation": "tier1" },
    "@aarusso-nyx/stynx-auth": { "mutation": "tier1" },
    "@aarusso-nyx/stynx-backend": { "mutation": "strict" },
    "@aarusso-nyx/stynx-cli": { "mutation": "strict" },
    "@aarusso-nyx/stynx-data": { "mutation": "tier1" },
    "@aarusso-nyx/stynx-privacy": { "mutation": "strictest" },
    "@aarusso-nyx/stynx-preferences": { "mutation": "tier3" },
    "@aarusso-nyx/stynx-tenancy": { "mutation": "tier1" },
    "@aarusso-nyx/stynx-core": { "mutation": "tier2" },
    "@aarusso-nyx/stynx-flow": { "mutation": "strict" },
    "@aarusso-nyx/stynx-i18n": { "mutation": "strict" },
    "@aarusso-nyx/stynx-idempotency": { "mutation": "tier2" },
    "@aarusso-nyx/stynx-ratelimit": { "mutation": "tier2" },
    "@aarusso-nyx/stynx-sessions": { "mutation": "tier2" },
    "@aarusso-nyx/stynx-storage": { "mutation": "tier2" },
    "@aarusso-nyx/stynx-testing": { "mutation": "strict" }
  },
  "notApplicable": [
    {
