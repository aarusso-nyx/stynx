{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "paths": {
      "@aarusso-nyx/stynx-backend": ["../../packages/backend/src/index.ts"],
      "@aarusso-nyx/stynx-contracts": ["../../packages/contracts/src/index.ts"],
      "@aarusso-nyx/stynx-auth": ["../../packages/auth/src/index.ts"],
      "@aarusso-nyx/stynx-audit": ["../../packages/audit/src/index.ts"],
      "@aarusso-nyx/stynx-cli": ["../../packages/cli/src/index.ts"],
      "@aarusso-nyx/stynx-core": ["../../packages/core/src/index.ts"],
      "@aarusso-nyx/stynx-logging": ["../../packages/logging/src/index.ts"],
      "@aarusso-nyx/stynx-health": ["../../packages/health/src/index.ts"],
      "@aarusso-nyx/stynx-flow": ["../../packages/flow/src/index.ts"],
      "@aarusso-nyx/stynx-data": ["../../packages/data/src/index.ts"],
      "@aarusso-nyx/stynx-i18n": ["../../packages/i18n/src/index.ts"],
      "@aarusso-nyx/stynx-privacy": ["../../packages/privacy/src/index.ts"],
      "@aarusso-nyx/stynx-ratelimit": ["../../packages/ratelimit/src/index.ts"],
      "@aarusso-nyx/stynx-idempotency": ["../../packages/idempotency/src/index.ts"],
      "@aarusso-nyx/stynx-sessions": ["../../packages/sessions/src/index.ts"],
      "@aarusso-nyx/stynx-storage": ["../../packages/storage/src/index.ts"],
      "@aarusso-nyx/stynx-tenancy": ["../../packages/tenancy/src/index.ts"],
      "@aarusso-nyx/stynx-testing": ["../../packages/testing/src/index.ts"],
      "@aarusso-nyx/stynx-signature": ["../../packages/signature/src/index.ts"],
      "@aarusso-nyx/stynx-pdf": ["../../packages/pdf/src/index.ts"],
      "@aarusso-nyx/stynx-pdf-a": ["../../packages/pdf-a/src/index.ts"],
      "@aarusso-nyx/stynx-pdf-a-vera-docker": ["../../packages/pdf-a-vera-docker/src/index.ts"],
      "@aarusso-nyx/stynx-feature-flags": ["../../packages/feature-flags/src/index.ts"],
      "@aarusso-nyx/stynx-integration-adapter": ["../../packages/integration-adapter/src/index.ts"],
      "@aarusso-nyx/stynx-internal-reference-api": ["../../reference/api/src/main.ts"],
      "@aarusso-nyx/stynx-internal-reference-web": ["../../reference/web/src/main.ts"],
      "@aarusso-nyx/stynx-sdk": ["../../packages-web/sdk/src/index.ts"],
      "@aarusso-nyx/stynx-angular": ["../../packages-web/angular/src/index.ts"],
      "@aarusso-nyx/stynx-angular-tenancy": ["../../packages-web/angular-tenancy/src/index.ts"],
      "@aarusso-nyx/stynx-angular-auth": ["../../packages-web/angular-auth/src/index.ts"],
      "@aarusso-nyx/stynx-angular-ui": ["../../packages-web/angular-ui/src/index.ts"],
      "@aarusso-nyx/stynx-angular-i18n": ["../../packages-web/angular-i18n/src/index.ts"],
      "@aarusso-nyx/stynx-angular-trash": ["../../packages-web/angular-trash/src/index.ts"],
      "@aarusso-nyx/stynx-angular-storage": ["../../packages-web/angular-storage/src/index.ts"],
      "@aarusso-nyx/stynx-angular-sessions": ["../../packages-web/angular-sessions/src/index.ts"],
      "@aarusso-nyx/stynx-angular-profile": ["../../packages-web/angular-profile/src/index.ts"],
      "@aarusso-nyx/stynx-angular-iam": ["../../packages-web/angular-iam/src/index.ts"],
      "@aarusso-nyx/stynx-angular-iam/catalogs/*": ["../../packages-web/angular-iam/src/i18n/*"],
      "@aarusso-nyx/stynx-angular-flow": ["../../packages-web/angular-flow/src/index.ts"]
    }
  }
}
