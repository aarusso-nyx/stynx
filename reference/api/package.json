{
  "name": "@aarusso-nyx/stynx-internal-reference-api",
  "private": true,
  "version": "0.3.5",
  "description": "Reference API app exercising the STYNX backend package family",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "smoke:local": "bash scripts/smoke-local.sh",
    "start": "node dist/reference/api/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config ../../tools/eslint-config/nest.mjs \"src/**/*.ts\"",
    "test": "vitest run --config ./vitest.config.ts",
    "test:int": "vitest run --config ./vitest.config.ts test/integration/*.spec.ts",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts test/e2e/flows/*.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@aarusso-nyx/stynx-backend": "workspace:*",
    "@aarusso-nyx/stynx-audit": "workspace:*",
    "@aarusso-nyx/stynx-auth": "workspace:*",
    "@aarusso-nyx/stynx-core": "workspace:*",
    "@aarusso-nyx/stynx-data": "workspace:*",
    "@aarusso-nyx/stynx-flow": "workspace:*",
    "@aarusso-nyx/stynx-health": "workspace:*",
    "@aarusso-nyx/stynx-idempotency": "workspace:*",
    "@aarusso-nyx/stynx-logging": "workspace:*",
    "@aarusso-nyx/stynx-preferences": "workspace:*",
    "@aarusso-nyx/stynx-ratelimit": "workspace:*",
    "@aarusso-nyx/stynx-sessions": "workspace:*",
    "@aarusso-nyx/stynx-storage": "workspace:*",
    "@aarusso-nyx/stynx-tenancy": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@nestjs/testing": "^11.1.27",
    "@types/node": "25.6.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.14.0",
    "typescript": "6.0.3"
  }
}
